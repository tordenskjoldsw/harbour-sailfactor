[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-sailtoken
Exec=harbour-sailtoken
Name=SailToken

[X-Sailjail]
# Changing OrganizationName or ApplicationName moves the app's data
# directories, so keep both stable once released.
OrganizationName=de.tordenskjold
ApplicationName=sailtoken
Permissions=Camera;Documents;Downloads;Internet
